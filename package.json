{
  "name": "packit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write src vite.config.ts index.html",
    "format:check": "prettier --check src vite.config.ts index.html",
    "shell:build": "node scripts/build-shell.mjs",
    "dev:desktop": "node scripts/build-shell.mjs && vite",
    "build:desktop": "node scripts/build-shell.mjs --release && npm run build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/verify-branding.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "installer:build": "tauri build --bundles nsis --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "license": "GPL-3.0-only"
}
